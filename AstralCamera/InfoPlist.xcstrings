    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AstralCamera takes a series of RAW photos of the sky and stacks them into one long exposure."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AstralCamera wykonuje serię zdjęć RAW nieba i składa je w jedno długie naświetlenie."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your latitude sets the axis the sky rotates around (the celestial pole)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerokość geograficzna wyznacza oś obrotu nieba (biegun niebieski)."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The phone's orientation predicts how the stars move and detects when it is on a tripod."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientacja telefonu pozwala przewidzieć ruch gwiazd i wykryć statyw."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The finished sky photo is saved to your Photos library."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotowe zdjęcie nieba zostanie zapisane w bibliotece Zdjęcia."
