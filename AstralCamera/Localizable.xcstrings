      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamianie…"
          }
        }
      }
    },
    "Sweeping focus and measuring star peak brightness (highest = sharpest). Keep the phone still." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwam ostrość i mierzę jasność szczytową gwiazd (najwyższa = najostrzej). Nie ruszaj telefonu."
          }
        }
      }
    },
    "Telephoto" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teleobiektyw"
          }
        }
      }
    },
    "The dark frames contain light (level %@). Cover the lens completely and try again." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darki zawierają światło (poziom %@). Zakryj obiektyw całkowicie i spróbuj ponownie."
          }
        }
      }
    },
    "The phone is critically hot – finishing and saving the session." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon jest krytycznie gorący – kończę i zapisuję sesję."
