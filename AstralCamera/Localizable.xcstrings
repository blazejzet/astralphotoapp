    },
    "Autofocus cancelled." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-ostrość przerwana."
          }
        }
      }
    },
    "Autofocus found no stars. Check ISO, clouds and that the camera faces the sky." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-ostrość nie znalazła gwiazd. Sprawdź ISO, chmury i czy aparat patrzy w niebo."
          }
        }
      }
    },
    "Autofocus: point the camera at the stars and keep the tripod still (about 1.5 min)." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-ostrość: skieruj aparat na gwiazdy i nie ruszaj statywu (ok. 1,5 min)."
          }
        }
      }
    },
    "Bayer RAW unavailable – using ProRAW (%@). Frames decode more slowly." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayer RAW niedostępny – używam ProRAW (%@). Klatki dekodują się wolniej."
