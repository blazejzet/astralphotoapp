      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-ostrość"
          }
        }
      }
    },
    "Autofocus %lld%% – focus %@" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-ostrość %lld%% – ostrość %@"
