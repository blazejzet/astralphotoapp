      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darki: zakryj obiektyw przy tych samych ISO i czasie. Na statywie samowyzwalacz jest zbędny – ekran może zostać włączony."
