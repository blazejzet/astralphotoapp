    "No camera access. Turn it on in Settings." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do aparatu. Włącz go w Ustawieniach."
          }
        }
      }
    },
    "No compass or location – the sky's rotation axis will be found from the stars alone." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak kompasu lub lokalizacji – oś obrotu nieba zostanie wyznaczona wyłącznie z gwiazd."
          }
        }
      }
    },
    "No Photos access – the file is in the Files app." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do Zdjęć – plik jest w aplikacji Pliki."
          }
        }
      }
    },
    "No rear camera found (the Simulator has no camera – run on an iPhone)." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono tylnego aparatu (symulator nie ma kamery – uruchom na iPhonie)."
